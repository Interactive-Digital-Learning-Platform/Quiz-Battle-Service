# Quiz-Battle-Service -- settings for a deployment. Copy to .env (never commit .env) or set these as the platform's
# environment variables. Every other setting in app/core/config.py has a working default.
#
# Note for `docker run --env-file`: Docker keeps everything after "=" -- don't put "# comments" on a value's line.

# ── Service ──────────────────────────────────────────────────────────────────
# The code defaults to development, but the Docker image sets production: no /docs, closed CORS, INFO logging,
# AUTH_BYPASS ignored. Only use "development" locally.
ENVIRONMENT=production
PROJECT_NAME=Quiz Battle Service

# ── Database (required) ──────────────────────────────────────────────────────
# The SAME Neon Postgres as Personalized-Quiz-Service -- this service reads/writes its users/questions tables.
# asyncpg driver, pooled host, no query string.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb

# ── Redis (required for matchmaking and live matches) ────────────────────────
# Reachable from the container (not localhost). Use rediss:// for a TLS-only managed Redis.
REDIS_URL=redis://REDIS-HOST:6379/0

# ── Clerk auth (required) ────────────────────────────────────────────────────
# Same Clerk project as Personalized-Quiz-Service (shared users).
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# Optional checks on the token's aud / azp claims (empty = not checked).
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
AUTH_BYPASS=false

# ── Groq (required) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Match questions: AI first (fresh, unseen by both players), the question pool as fallback. false = pool only.
BATTLE_AI_FIRST_ENABLED=true

# ── Container (read by the Dockerfile's start command) ───────────────────────
# Run `alembic upgrade head` on start. Set false when running several copies and run migrations once yourself.
RUN_MIGRATIONS=true
# Uvicorn worker processes. Keep 1 per container: the matchmaking sweep, stale-match reaper and question-pool
# warm-up run in every worker, and per-process limits (e.g. concurrent AI generations) multiply with workers.
# Live matches already work across several containers -- their events go through Redis pub/sub.
WEB_CONCURRENCY=1
